{
  "name": "@donotdev/testing",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Entity CRUD and storage integration testing for DoNotDev — generate payloads, run full CRUD flows, debug adapter chains",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "@donotdev/core": "^0.2.3"
  },
  "devDependencies": {
    "@donotdev/core": "workspace:*",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/dndev.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "testing",
    "crud",
    "entity",
    "integration-test",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
